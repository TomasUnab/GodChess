      "css": ".ds-btn-secondary{display:inline-flex;align-items:center;min-height:38px;padding:0 16px;border:1px solid #f2f2f2;border-radius:0;background:transparent;color:#f2f2f2;font:650 15px/1 'Archivo Variable','Archivo',system-ui,sans-serif;transition:background-color .15s ease-out}.ds-btn-secondary:hover{background:#1f2226}.ds-btn-secondary:focus-visible{outline:2px solid #ffb000;outline-offset:2px}"
    },
    {
      "name": "Botón fantasma",
      "kind": "button",
      "refersTo": "button-ghost",
      "description": "Acción terciaria; el borde aparece en hover.",
      "html": "<button class=\"ds-btn-ghost\">Girar tablero</button>",
      "css": ".ds-btn-ghost{display:inline-flex;align-items:center;min-height:38px;padding:0 16px;border:1px solid transparent;border-radius:0;background:transparent;color:#f2f2f2;font:650 15px/1 'Archivo Variable','Archivo',system-ui,sans-serif;transition:border-color .15s ease-out}.ds-btn-ghost:hover{border-color:#2c3035}.ds-btn-ghost:focus-visible{outline:2px solid #ffb000;outline-offset:2px}"
    },
    {
      "name": "Campo de texto",
      "kind": "input",
      "refersTo": "input",
