      "html": "<p class=\"ds-moves\"><button>14. Cf3</button> <button class=\"cur\">Dxb2??</button> <button class=\"mis\">15. Tb1?</button> <button>Da3?!</button></p>",
      "css": ".ds-moves{font:450 16.5px/1.8 'Archivo Variable','Archivo',system-ui,sans-serif;color:#c4c6ca;background:#16181b;padding:8px}.ds-moves button{border:0;border-radius:0;background:none;padding:1px 3px;font:inherit;color:inherit}.ds-moves button:hover{background:#1f2226}.ds-moves .cur{background:#ff4d5a;color:#16181b}.ds-moves .mis{color:#ffb000}"
    },
