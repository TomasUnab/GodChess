      "html": "<input class=\"ds-input\" placeholder=\"Buscar jugador o apertura\">",
      "css": ".ds-input{min-height:40px;width:260px;padding:8px 10px;border:1px solid #a7aaaf;border-radius:0;background:#0f1113;color:#f2f2f2;caret-color:#ff4d5a;font:400 15px/1.5 'Archivo Variable','Archivo',system-ui,sans-serif}.ds-input::placeholder{color:#a7aaaf}.ds-input:focus-visible{outline:2px solid #ffb000;outline-offset:0;border-color:#f2f2f2}"
    },
    {
      "name": "Pestañas de cabecera",
      "kind": "nav",
      "refersTo": "tab-active",
      "description": "Versalitas condensadas; la activa en ámbar con subrayado interior.",
      "html": "<nav class=\"ds-tabs\"><button class=\"on\">Análisis</button><button>Partidas</button><button>Entrenar</button></nav>",
      "css": ".ds-tabs{display:flex;gap:2px;height:64px;padding:0 24px;background:#0b0b0d}.ds-tabs button{border:0;background:none;padding:0 14px;color:#a7aaaf;font:600 13.5px/1 'Archivo Variable','Archivo',system-ui,sans-serif;font-stretch:75%;letter-spacing:.1em;text-transform:uppercase;transition:color .15s ease-out}.ds-tabs button:hover{color:#f2f2f2}.ds-tabs button.on{background:#16181b;color:#ffb000;box-shadow:inset 0 -3px 0 #ffb000}.ds-tabs button:focus-visible{outline:2px solid #f2f2f2;outline-offset:-4px}"
    },
    {
      "name": "Chip de anotación",
      "kind": "chip",
      "refersTo": "chip",
      "description": "NAG seleccionable.",
      "html": "<div class=\"ds-chips\"><button class=\"ds-chip on\">!!</button><button class=\"ds-chip\">?!</button><button class=\"ds-chip\">??</button></div>",
      "css": ".ds-chips{display:flex;gap:6px}.ds-chip{min-width:34px;height:32px;padding:0 9px;border:1px solid #2c3035;border-radius:0;background:transparent;color:#f2f2f2;font:700 13.5px/1 'Archivo Variable','Archivo',system-ui,sans-serif}.ds-chip:hover{border-color:#f2f2f2}.ds-chip.on{background:#f2f2f2;color:#16181b;border-color:#f2f2f2}.ds-chip:focus-visible{outline:2px solid #ffb000;outline-offset:2px}"
    },
    {
      "name": "Cifra de paleta partida",
      "kind": "custom",
      "refersTo": "flap-cell",
      "description": "Firma del mundo: cada carácter en su celda negra, que gira al cambiar.",
      "html": "<span class=\"ds-flap\"><span>+</span><span>0</span><span>,</span><span>8</span><span>4</span></span> <span class=\"ds-flap bad\"><span>2</span><span class=\"gap\"></span><span>1</span></span>",
      "css": ".ds-flap{display:inline-flex;gap:.07em;font:700 34px/1 'Archivo Variable','Archivo',system-ui,sans-serif;font-stretch:62%}.ds-flap>span{position:relative;display:inline-block;min-width:.66em;padding:.05em .09em .02em;border-radius:2px;background:#0b0b0d;color:#f2f2f2;text-align:center;line-height:1.12;box-shadow:inset 0 0 0 1px rgb(255 255 255 / .07);animation:ds-flap-turn .26s cubic-bezier(.3,.7,.25,1) both}.ds-flap>span::after{content:'';position:absolute;left:0;right:0;top:50%;height:1px;background:rgb(0 0 0 / .9);box-shadow:0 1px 0 rgb(255 255 255 / .06)}.ds-flap>span.gap{min-width:.3em;padding:0;background:transparent;box-shadow:none}.ds-flap>span.gap::after{display:none}.ds-flap.bad>span{color:#ff4d5a}@keyframes ds-flap-turn{0%{transform:perspective(200px) rotateX(-88deg);filter:brightness(1.8)}100%{transform:none;filter:none}}@media (prefers-reduced-motion:reduce){.ds-flap>span{animation:none}}"
    },
    {
      "name": "Notación con gravedad",
      "kind": "custom",
      "refersTo": "move-current",
